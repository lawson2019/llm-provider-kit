{
  "name": "llm-provider-kit",
  "version": "0.5.0",
  "description": "LLM Provider 配置注册表与配置页工具集（Schema v2）：126 个 Provider 的接入面、鉴权模式、计费、风险与运行时契约，可直接驱动表单与请求预览，并附在线 Demo 与配置页生成器。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./node": "./src/node.mjs",
    "./schema": "./schemas/provider.schema.json",
    "./data/providers.json": "./data/providers.json",
    "./data/agents.json": "./data/agents.json",
    "./data/tiers.json": "./data/tiers.json"
  },
  "bin": {
    "llm-provider-kit": "./bin/cli.mjs",
    "provider-registry": "./bin/cli.mjs"
  },
  "files": [
    "src",
    "bin",
    "data",
    "schemas",
    "types",
    "README.md",
    "LICENSE",
    "scripts",
    "skills",
    "CHANGELOG.md"
  ],
  "scripts": {
    "validate": "node bin/cli.mjs validate",
    "list": "node bin/cli.mjs list",
    "demo": "node scripts/build-demo.mjs && node scripts/serve.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "export:json": "node bin/cli.mjs export --format json --out dist/providers.json",
    "export:ts": "node bin/cli.mjs export --format ts --out dist/providers.ts",
    "test": "node scripts/smoke.mjs",
    "scaffold": "node scripts/scaffold.mjs",
    "test:scaffold": "node scripts/test-scaffold.mjs",
    "test:demo": "node scripts/test-demo-config.mjs",
    "test:all": "npm test && npm run test:demo && npm run test:scaffold"
  },
  "keywords": [
    "ai",
    "llm",
    "provider",
    "registry",
    "json-schema",
    "form-schema",
    "acp",
    "agent",
    "configuration",
    "github-pages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lawson2019/llm-provider-kit"
  },
  "homepage": "https://lawson2019.github.io/llm-provider-kit/",
  "bugs": {
    "url": "https://github.com/lawson2019/llm-provider-kit/issues"
  }
}
